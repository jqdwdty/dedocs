\guide[name="document-paragraphs", part="word/document.xml", format="paragraphs", boundary=":::DEDOCS_GUIDE_1_ac4358603bd5:::"]
:::DEDOCS_GUIDE_1_ac4358603bd5:::
\p[index="0000", style="Heading1"] Introduction
\p[index="0001"] This is the first paragraph of the introduction. It contains some text about platform governance and political advertising.
\p[index="0002"] The second paragraph discusses Meta's advertising ban and its consequences for electoral transparency.
\p[index="0003", style="Heading1"] Methods
\p[index="0004"] We developed an automated monitoring system that collected 268,635 advertisements from the Meta Ad Library.
\p[index="0005", style="Heading1"] Results
\p[index="0006"] We confirmed 192 accounts as political advertisers that placed a total of 1,329 ads during the campaign period.
\p[index="0007", style="Heading1"] Discussion
\p[index="0008"] The findings document a specific failure mode of platform self-regulation.
:::DEDOCS_GUIDE_1_ac4358603bd5:::
\end{guide}

